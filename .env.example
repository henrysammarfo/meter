# Copy to .env / grounds/.env — never commit real keys.
# Rotate any key that was pasted into chat.

# Live research (required for /api/v1/research)
TAVILY_API_KEY=

# TinyFish: Search + Fetch are free; Agent automation needs wallet credits
TINYFISH_API_KEY=

# LLM via AgentRouter (no OpenAI key). Base must include /v1 for OpenAI-compat.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=gpt-4o-mini

# Optional: Venice AI if AgentRouter is unreachable from your host
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/api/v1

# METER settlement
METER_TAKE_RATE=0.009
METER_DAILY_CAP_USDC=20
METER_RESEARCH_PRICE_USDC=0.02
METER_LEDGER_PATH=data/ledger.json

# x402 facilitator (testnet default). Omit pay-to to disable on-chain settle path.
METER_FACILITATOR_URL=https://x402.org/facilitator
# METER_PAY_TO=0xYourReceiveAddress
# METER_SETTLE_NETWORK=base-sepolia
# METER_USDC_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Binance Agent OS (required for production Binance settle — not optional in Track A live)
# BINANCE_AGENT_OS_API_KEY=
# BINANCE_X402_FACILITATOR_URL=
