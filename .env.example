# Copy to .env / grounds/.env — never commit real keys.
# Rotate any key pasted into chat.

# Live research (required for /api/v1/research)
TAVILY_API_KEY=
TINYFISH_API_KEY=

# LLM via AgentRouter (no OpenAI). Base must include /v1 for OpenAI-compat.
AGENTROUTER_API_KEY=
# Official API host (agentrouter.org is Aliyun-WAF gated from many cloud IPs)
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=gpt-4o-mini

# Explicit LLM vendor — never auto-swaps. Omit to keep research synthesis off.
# METER_LLM_PROVIDER=agentrouter
# METER_LLM_PROVIDER=venice
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/api/v1
# VENICE_MODEL=llama-3.3-70b

# Operator key — when set (or METER_PRODUCTION=1), fund/invoice mutations require X-Meter-Operator-Key
# METER_OPERATOR_KEY=
# METER_PRODUCTION=0

# METER settlement
METER_TAKE_RATE=0.009
METER_DAILY_CAP_USDC=20
METER_RESEARCH_PRICE_USDC=0.02
METER_LEDGER_PATH=data/ledger.json

# x402 facilitator (testnet default). Omit pay-to to disable on-chain settle.
METER_FACILITATOR_URL=https://x402.org/facilitator
# METER_PAY_TO=0xYourReceiveAddress
# METER_SETTLE_NETWORK=base-sepolia
# METER_USDC_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Binance Agent OS (required for Track A production Binance settle)
# BINANCE_AGENT_OS_API_KEY=
# BINANCE_X402_FACILITATOR_URL=
